<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Gestion_Immobilière.View.Forms.GererAppartementForm"
      Title="GererAppartementForm" Height="318">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Text="Nom" Margin="5,0,5,0" VerticalAlignment="Center" Height="16"/>
        <TextBox x:Name="txtNom" Grid.Row="0" Grid.Column="1" Margin="5,2,5,2"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Valeur" Margin="5,0,5,0" VerticalAlignment="Center" Height="16"/>
        <TextBox x:Name="txtValeur" Grid.Column="1" Margin="5,2,5,2" Grid.Row="1" TextChanged="txtValeur_TextChanged"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Adresse" Margin="5,0,5,0" VerticalAlignment="Center" Height="16"/>
        <TextBox x:Name="txtAdresse" Grid.Row="2" Grid.Column="1" Margin="5,2,5,2"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Surface" Margin="5,0,5,0" VerticalAlignment="Center" Height="16"/>
        <TextBox x:Name="txtSurface" Grid.Row="3" Grid.Column="1" Margin="5,2,5,2" TextChanged="txtSurface_TextChanged"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Etage" Margin="5,0,5,0" VerticalAlignment="Center" Height="16"/>
        <TextBox x:Name="txtEtage" Grid.Row="4" Grid.Column="1" Margin="5,2,5,2" TextChanged="txtEtage_TextChanged"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Ascenseur" Margin="5,0,5,0" VerticalAlignment="Center" Height="16" />
        <TextBox x:Name="txtAscenseur" Grid.Row="5" Grid.Column="1" Margin="5,2,5,2" TextChanged="txtAscenseur_TextChanged"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Chauff Commun" Margin="5,0,5,0" VerticalAlignment="Center" Height="16"/>
        <CheckBox x:Name="txtChauffCommun" Grid.Row="6" Grid.Column="1" Margin="44,5,44,5"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Nombre Piece" Margin="5,0,5,0" VerticalAlignment="Center" Height="16"/>
        <TextBox x:Name="txtNbPiece" Grid.Row="7" Grid.Column="1" Margin="5,2,5,2"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Nombre Chambre" Margin="5,0,5,0" VerticalAlignment="Center" Height="16"/>
        <TextBox x:Name="txtNbChambre" Grid.Row="8" Grid.Column="1" Margin="5,2,5,2"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Cave" Margin="5,0,5,0" VerticalAlignment="Center" Height="16" />
        <CheckBox x:Name="txtCave" Grid.Row="9" Grid.Column="1" Margin="43,5,43,5" RenderTransformOrigin="0.493,0.527" Checked="txtCave_Checked" IsChecked="False"/>

        <TextBlock Grid.Row="10" Grid.Column="0" Text="Parking" Margin="5,0,5,0" VerticalAlignment="Center" Height="16" />
        <CheckBox x:Name="txtParking" Grid.Row="10" Grid.Column="1" Margin="43,5,43,5" RenderTransformOrigin="0.493,0.527" Checked="txtCave_Checked" IsChecked="False"/>

        <Button Grid.Row="11" Grid.Column="1"
                Content="Ajouter"
                Width="100"
                HorizontalAlignment="Center"
                Margin="0,3,0,3"
                Padding="8,4"
                Click="BtnAjouter_Click"/>
    </Grid>
</Page>
