<Page x:Class="Gestion_Immobilière.View.Forms.GererBienForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Gestion_Immobilière.View.Forms"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GererBienForm">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ComboBox x:Name="cboTypesBien"
                  Grid.Row="0"
                  Height="30"
                  Margin="10"
                  SelectedIndex="0"
                  SelectionChanged="CboTypesBien_SelectionChanged">
            <ComboBoxItem Content="Box" Tag="Box"/>
        </ComboBox>

        <Frame x:Name="frmBien"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Margin="10,0,10,10"/>
    </Grid>
</Page>
