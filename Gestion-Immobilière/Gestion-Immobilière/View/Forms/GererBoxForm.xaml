<Page x:Class="Gestion_Immobilière.View.Forms.GererBoxForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="GererBoxForm">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtNom" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Valeur" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtValeur" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Adresse" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtAdresse" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Surface" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtSurface" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <Button Grid.Row="4" Grid.Column="1"
                Content="Ajouter"
                Width="100"
                HorizontalAlignment="Right"
                Margin="5"
                Padding="8,4"
                Click="BtnAjouter_Click"/>
    </Grid>
</Page>
